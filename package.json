{
    "name": "medflow",
    "version": "1.0.0",
    "description": "Offline-first Android mobile app for medication & vitals tracking with Guardian Mode sync",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "preview": "vite preview",
        "lint": "eslint src --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
        "type-check": "tsc --noEmit",
        "android:build": "npm run build && npx cap sync && npx cap open android",
        "android:run": "npx cap run android",
        "ios:build": "npm run build && npx cap sync && npx cap open ios",
        "ios:run": "npx cap run ios",
        "sync": "npx cap sync",
        "db:migrate": "node scripts/migrate.js"
    },
    "dependencies": {
        "@capacitor-community/sqlite": "^8.1.1",
        "@capacitor-mlkit/text-recognition": "^8.2.1",
        "@capacitor/android": "^8.6.2",
        "@capacitor/app": "^8.1.2",
        "@capacitor/camera": "^8.1.5",
        "@capacitor/core": "^8.6.2",
        "@capacitor/filesystem": "^8.1.5",
        "@capacitor/local-notifications": "^8.3.1",
        "@capacitor/share": "^8.0.3",
        "@supabase/supabase-js": "^2.47.0",
        "uuid": "^10.0.0"
    },
    "devDependencies": {
        "@capacitor/cli": "^8.6.2",
        "@types/node": "^22.9.0",
        "@typescript-eslint/eslint-plugin": "^8.17.0",
        "@typescript-eslint/parser": "^8.17.0",
        "@vitejs/plugin-vue": "^6.0.11",
        "autoprefixer": "^10.4.20",
        "eslint": "^9.15.0",
        "postcss": "^8.4.47",
        "tailwindcss": "^3.4.17",
        "typescript": "^5.7.2",
        "vite": "^5.4.17"
    }
}
